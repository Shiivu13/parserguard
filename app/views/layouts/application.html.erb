<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · ParserGuard" : "ParserGuard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <%= link_to "ParserGuard", root_path, class: "brand" %>
      <nav aria-label="Main">
        <%= link_to "Overview", root_path, class: ("active" if current_page?(root_path)) %>
        <%= link_to "Drift", drift_events_path, class: ("active" if controller_name == "drift_events") %>
        <%= link_to "Suggestions", suggestions_path, class: ("active" if controller_name == "suggestions") %>
        <%= link_to "Contracts", contracts_path, class: ("active" if controller_name == "contracts") %>
        <%= link_to "Snapshots", snapshots_path, class: ("active" if controller_name == "snapshots") %>
      </nav>
    </header>

    <main class="page">
      <% flash.each do |type, message| %>
        <p class="flash flash-<%= type %>" role="status"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
