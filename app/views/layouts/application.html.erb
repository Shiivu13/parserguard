<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · ParserGuard" : "ParserGuard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <%= link_to root_path, class: "brand" do %>
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2 4 6.5v8.2c0 7.3 5 13.4 12 15.3 7-1.9 12-8 12-15.3V6.5L16 2Z" fill="var(--accent)"/><path d="m11 16.2 3.4 3.4L21.5 12" fill="none" stroke="var(--accent-text)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        ParserGuard
      <% end %>
      <nav aria-label="Main">
        <%= nav_link "Overview", root_path, controller: "dashboard" %>
        <%= nav_link "Drift", drift_events_path, controller: "drift_events" %>
        <%= nav_link suggestions_path, controller: "suggestions" do %>
          Suggestions<% if (n = pending_suggestions_count).positive? %><span class="nav-count"><%= n %></span><% end %>
        <% end %>
        <%= nav_link "Contracts", contracts_path, controller: "contracts" %>
        <%= nav_link "Snapshots", snapshots_path, controller: "snapshots" %>
      </nav>
    </header>

    <main class="page">
      <% flash.each do |type, message| %>
        <p class="flash flash-<%= type %>" role="status"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
