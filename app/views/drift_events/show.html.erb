<%= page_head "Drift on #{target_label(@event.engine, @event.locale, @event.device)}",
              "Baseline v#{@baseline.version} compared with v#{@candidate.version}, #{ago(@event.created_at)}." do %>
  <%= severity_badge(@event.severity) %>
  <% unless @event.acknowledged_at %>
    <%= button_to "Acknowledge", acknowledge_drift_event_path(@event), class: "btn" %>
  <% end %>
<% end %>

<section class="stats">
  <div class="stat"><span class="stat-label">Drift score</span><span class="stat-value"><%= score(@event.drift_score) %></span></div>
  <div class="stat"><span class="stat-label">Tag structure drift</span><span class="stat-value"><%= score(@event.tag_drift) %></span></div>
  <div class="stat"><span class="stat-label">Class drift</span><span class="stat-value"><%= score(@event.class_drift) %></span></div>
  <div class="stat"><span class="stat-label">Snapshots</span>
    <span class="stat-value small">
      <%= link_to "v#{@baseline.version}", snapshot_path(@baseline) %> → <%= link_to "v#{@candidate.version}", snapshot_path(@candidate) %>
    </span>
  </div>
</section>

<h2>Broken fields</h2>
<% if @event.broken_fields.empty? %>
  <p class="empty">Every contract still extracts correctly. The layout changed, the data did not.</p>
<% else %>
  <ul class="pill-list">
    <% @event.broken_fields.each do |f| %>
      <li><code><%= f["contract"] %>#<%= f["field"] %></code> <span class="muted">rate <%= pct(f["rate"]) %></span></li>
    <% end %>
  </ul>
<% end %>

<h2>Suggestions</h2>
<% if @suggestions.empty? %>
  <p class="empty">No suggestions yet. Healing runs in the background after detection.</p>
<% else %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Field</th><th>Current selector</th><th>Best candidate</th><th>Confidence</th><th>Status</th></tr></thead>
      <tbody>
        <% @suggestions.each do |s| top = s.top_candidate %>
          <tr>
            <td><%= link_to s.field_name, suggestion_path(s) %></td>
            <td><%= selector(s.old_selector) %></td>
            <td><%= top ? selector(top["selector"]) : tag.span("none found", class: "muted") %></td>
            <td><%= top ? metric(top["confidence"]) : "—" %></td>
            <td><%= status_badge(s.status) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<div class="split-even">
  <section>
    <h2>Class paths added</h2>
    <%= render "drift_events/paths", paths: @event.added_paths, sign: "+", kind: "added" %>
  </section>
  <section>
    <h2>Class paths removed</h2>
    <%= render "drift_events/paths", paths: @event.removed_paths, sign: "−", kind: "removed" %>
  </section>
</div>
