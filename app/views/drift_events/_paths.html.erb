<% if paths.empty? %>
  <p class="empty">None.</p>
<% else %>
  <div class="panel">
    <ol class="paths paths-<%= kind %>">
      <% paths.first(20).each do |p| %>
        <li><span class="delta"><%= sign %><%= p["delta"] %></span> <code><%= p["path"] %></code></li>
      <% end %>
    </ol>
    <% if paths.size > 20 %><p class="muted">and <%= paths.size - 20 %> more</p><% end %>
  </div>
<% end %>
