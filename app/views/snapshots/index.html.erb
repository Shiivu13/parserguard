<% content_for :title, "Snapshots" %>
<h1>Snapshots<%= " · #{@engine}" if @engine %></h1>
<% if @snapshots.empty? %>
  <p class="empty">No snapshots.</p>
<% else %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Captured</th><th>Target</th><th>Version</th><th>Source</th><th>Size</th><th></th></tr></thead>
      <tbody>
        <% @snapshots.each do |s| %>
          <tr>
            <td><%= ago(s.captured_at) %></td>
            <td><%= target_label(s.engine, s.locale, s.device) %></td>
            <td><%= link_to "v#{s.version}", snapshot_path(s) %><%= tag.span(" baseline", class: "badge badge-none") if s.baseline %></td>
            <td><%= s.source %> <span class="muted"><%= s.source_ref %></span></td>
            <td><%= number_to_human_size(s.byte_size) %></td>
            <td><%= link_to "Open", snapshot_path(s) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
