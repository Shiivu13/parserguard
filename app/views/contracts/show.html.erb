<%= page_head @contract.key, "Version #{@contract.version} · minimum extraction rate #{pct(@contract.min_extraction_rate)}" %>

<div class="panel">
  <dl class="kv">
    <dt>Scope</dt><dd><%= selector(@contract.scope_selector) %></dd>
    <dt>Container</dt><dd><%= selector(@contract.container_selector) %></dd>
  </dl>
</div>

<h2>Fields</h2>
<% last = @runs.first %>
<div class="table-wrap">
  <table>
    <thead><tr><th>Name</th><th>Selector</th><th>Extract</th><th>Type</th><th>Required</th><th>Last rate</th></tr></thead>
    <tbody>
      <% @contract.field_specs.each do |f| %>
        <tr>
          <td><%= f.name %></td>
          <td><%= selector(f.selector) %></td>
          <td><%= f.extract %></td>
          <td><%= f.value_type %></td>
          <td><%= f.required ? "yes" : "no" %></td>
          <td><%= last ? metric(last.field_rate(f.name)) : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2>Recent runs</h2>
<% if @runs.empty? %>
  <p class="empty">Never run.</p>
<% else %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>When</th><th>Snapshot</th><th>Contract</th><th>Containers</th><th>Extraction</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% @runs.each do |r| %>
          <tr>
            <td><%= ago(r.created_at) %></td>
            <td><%= link_to "snapshot", snapshot_path(r.snapshot_id) %></td>
            <td class="num">v<%= r.contract_version %></td>
            <td class="num"><%= r.container_count %></td>
            <td><%= metric(r.extraction_rate) %></td>
            <td><%= status_badge(r.status) %></td>
            <td class="right"><%= button_to "Re-run", run_contract_path(@contract, snapshot_id: r.snapshot_id), class: "btn btn-quiet btn-small" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<div class="split-even">
  <section>
    <h2>Selector history</h2>
    <% if @contract.revisions.empty? %>
      <p class="empty">No selector changes yet.</p>
    <% else %>
      <div class="panel">
        <ol class="revisions">
          <% @contract.revisions.reverse_each do |rev| %>
            <li>
              <strong>v<%= rev.version %></strong> · <%= rev.field_name %>:
              <%= selector(rev.from_selector, old: true) %> → <%= selector(rev.to_selector) %>
              <span class="muted"><%= ago(rev.at) %></span>
            </li>
          <% end %>
        </ol>
      </div>
    <% end %>
  </section>
  <section>
    <h2>Suggestions</h2>
    <% if @suggestions.empty? %>
      <p class="empty">None.</p>
    <% else %>
      <ul class="pill-list">
        <% @suggestions.each do |s| %>
          <li><%= link_to s.field_name, suggestion_path(s) %> <%= status_badge(s.status) %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
