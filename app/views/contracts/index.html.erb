<% content_for :title, "Contracts" %>
<h1>Contracts</h1>
<div class="table-wrap">
  <table>
    <thead><tr><th>Contract</th><th>Container</th><th>Fields</th><th>Min rate</th><th>Version</th><th>Active</th></tr></thead>
    <tbody>
      <% @contracts.each do |c| %>
        <tr>
          <td><%= link_to c.key, contract_path(c) %></td>
          <td><code><%= c.container_selector %></code></td>
          <td><%= c.field_specs.size %></td>
          <td><%= pct(c.min_extraction_rate) %></td>
          <td>v<%= c.version %></td>
          <td><%= c.active ? "yes" : "no" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
