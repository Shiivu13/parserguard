<% content_for :title, "Suggestion #{@suggestion.field_name}" %>

<div class="title-row">
  <h1><code><%= @contract.key %>#<%= @suggestion.field_name %></code></h1>
  <span data-suggestion-status><%= status_badge(@suggestion.status) %></span>
</div>
<p class="muted">
  Snapshot <%= @snapshot ? link_to(@snapshot.label, snapshot_path(@snapshot)) : "—" %> ·
  contract v<%= @contract.version %> ·
  <%= link_to "contract", contract_path(@contract) %>
</p>

<div class="split">
  <section class="panel">
    <h2>Before <span class="muted">(baseline)</span></h2>
    <p>Selector <code class="old"><%= @suggestion.old_selector %></code></p>
    <% field = @suggestion.container? ? @contract.required_fields.first&.name : @suggestion.field_name %>
    <% values = @baseline_run ? @baseline_run.items.filter_map { |i| i[field] }.first(5) : [] %>
    <% if values.any? %>
      <ol class="samples"><% values.each do |v| %><li><%= v %></li><% end %></ol>
    <% else %>
      <p class="empty">No baseline run recorded.</p>
    <% end %>
  </section>

  <section class="panel">
    <h2>After <span class="muted">(candidates on new snapshot)</span></h2>
    <% if @suggestion.candidates.empty? %>
      <p class="empty">No selector reached the confidence floor. This page likely needs a manual fix
        (or it is not a results page at all).</p>
    <% else %>
      <div data-controller="accept-suggestion"
           data-accept-suggestion-url-value="<%= accept_suggestion_path(@suggestion, format: :json) %>"
           data-accept-suggestion-pending-value="<%= @suggestion.pending? %>">
        <p class="error" data-accept-suggestion-target="error" hidden></p>
        <ol class="candidates">
          <% @suggestion.candidates.each_with_index do |c, i| %>
            <li class="candidate <%= 'chosen' if c['selector'] == @suggestion.accepted_selector %>"
                data-accept-suggestion-target="row">
              <div class="candidate-head">
                <code><%= c["selector"] %></code>
                <span class="muted"><%= c["kind"] %></span>
                <span class="conf"><%= meter(c["confidence"]) %> <%= pct(c["confidence"]) %></span>
              </div>
              <dl class="kv kv-inline">
                <dt>coverage</dt><dd><%= pct(c["coverage"]) %></dd>
                <dt>agreement</dt><dd><%= pct(c["agreement"]) %></dd>
                <dt>stability</dt><dd><%= pct(c["stability"]) %></dd>
                <dt>uniqueness</dt><dd><%= pct(c["uniqueness"]) %></dd>
              </dl>
              <% if c["samples"].present? %>
                <p class="sample-line"><%= c["samples"].join(" · ") %></p>
              <% end %>
              <% if @suggestion.pending? %>
                <button type="button" class="btn <%= 'btn-primary' if i.zero? %>"
                        data-action="accept-suggestion#accept"
                        data-accept-suggestion-selector-param="<%= c['selector'] %>">Accept</button>
              <% end %>
            </li>
          <% end %>
        </ol>
      </div>
    <% end %>
    <% if @suggestion.pending? %>
      <%= button_to "Reject all", reject_suggestion_path(@suggestion), class: "btn btn-quiet", form: { data: { reject_form: true } } %>
    <% end %>
  </section>
</div>
