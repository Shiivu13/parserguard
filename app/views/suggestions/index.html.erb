<%= page_head "Selector suggestions", "Replacement selectors proposed for broken fields. Nothing is applied until you accept it." %>

<nav class="tabs" aria-label="Status">
  <% %w[pending accepted rejected].each do |st| %>
    <%= link_to st.capitalize, suggestions_path(status: st), class: ("active" if st == @status) %>
  <% end %>
</nav>

<% if @suggestions.empty? %>
  <p class="empty">No <%= @status %> suggestions.</p>
<% else %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Created</th><th>Contract</th><th>Field</th><th>Current</th><th>Best candidate</th><th>Confidence</th></tr></thead>
      <tbody>
        <% @suggestions.each do |s| top = s.top_candidate %>
          <tr>
            <td><%= ago(s.created_at) %></td>
            <td><%= @contracts[s.contract_id]&.key %></td>
            <td><%= link_to s.field_name, suggestion_path(s) %></td>
            <td><%= selector(s.old_selector) %></td>
            <td><%= top ? selector(top["selector"]) : tag.span("none found", class: "muted") %></td>
            <td><%= top ? metric(top["confidence"]) : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
